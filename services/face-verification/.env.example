APP_NAME="UniAttend Face Verification Service"
APP_ENVIRONMENT="development"

DB_URI=
DB_HOST=
DB_PORT=5432
DB_NAME="postgres"
DB_USER=
DB_PASSWORD=
DB_SSL_MODE="require"

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=10

FACE_EMBEDDING_ENCRYPTION_KEY=

# InsightFace runtime configuration.
FACE_MODEL_NAME="buffalo_l"
FACE_MODEL_VERSION="1"
FACE_EXECUTION_PROVIDER="CPUExecutionProvider"
FACE_CONTEXT_ID=-1
FACE_DETECTION_SIZE=640
FACE_MINIMUM_DETECTION_CONFIDENCE=0.60
FACE_MAX_CONCURRENT_INFERENCES=1

# The face service delegates bearer-token validation and active student-profile
# resolution to the Core Backend.
CORE_API_URL="http://localhost:8000"
CORE_API_TIMEOUT_SECONDS=5
