APP_NAME="UniAttend Face Verification Service"
APP_ENVIRONMENT="development"

# Docker Compose passes these values from the root .env file. This service-level
# file is still useful when running uvicorn directly from this directory.
DB_URI=
DB_HOST=
DB_PORT=5432
DB_NAME="postgres"
DB_USER=
DB_PASSWORD=
DB_SSL_MODE="require"

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=10
