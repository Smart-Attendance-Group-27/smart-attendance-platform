APP_NAME="UniAttend Core API"
APP_ENVIRONMENT="development"

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# DB_URI takes precedence. When DB_URI is set, the individual DB_HOST/DB_PORT/
# DB_NAME/DB_USER/DB_PASSWORD values below are ignored. Use one style only.
# Never commit a filled-in .env and never paste a real URI into logs or tickets.
DB_URI="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Fallback style, used only when DB_URI is empty.
DB_HOST="aws-0-ap-northeast-2.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USER=
DB_PASSWORD=

DB_SSL_MODE="require"

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Keycloak access-token validation
# ---------------------------------------------------------------------------
# KEYCLOAK_EXPECTED_ISSUER must match the `iss` claim inside the access token
# byte for byte. A phone signing in through a LAN address produces a token whose
# issuer uses that LAN address, so this value has to match the address the
# client used, not the address the backend uses.
KEYCLOAK_EXPECTED_ISSUER="http://KEYCLOAK_HOST:8080/realms/uniattend"

# KEYCLOAK_JWKS_URL is fetched by the backend itself, so it can use whatever
# address the backend can reach (usually localhost).
KEYCLOAK_JWKS_URL="http://localhost:8080/realms/uniattend/protocol/openid-connect/certs"

KEYCLOAK_AUDIENCE="uniattend-api"
KEYCLOAK_SIGNING_ALGORITHM="RS256"
KEYCLOAK_JWKS_CACHE_SECONDS=300

# ---------------------------------------------------------------------------
# Geofence validation safeguards
# ---------------------------------------------------------------------------
# Radius and accuracy policy are stored per attendance session in PostgreSQL.
GEOFENCE_MAX_READING_AGE_SECONDS=30
GEOFENCE_MAX_FUTURE_SKEW_SECONDS=5
GEOFENCE_MAX_ATTEMPTS=3

# ---------------------------------------------------------------------------
# Deprecated
# ---------------------------------------------------------------------------
# TOKEN_SECRET is left over from the pre-Keycloak development login. No code
# reads it any more and it is never used to validate Keycloak tokens. It stays
# here only so existing local .env files keep loading.
# Generate a throwaway local value if you want one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TODO: delete this variable once every local .env has dropped it.
TOKEN_SECRET=
