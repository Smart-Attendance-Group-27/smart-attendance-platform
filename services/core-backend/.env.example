APP_NAME="UniAttend Core API"
APP_ENVIRONMENT="development"

# ---------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# ---------------------------------------------------------------------------
# DB_URI takes precedence. When DB_URI is set, the individual DB_HOST/DB_PORT/
# DB_NAME/DB_USER/DB_PASSWORD values below are ignored. Use one style only.
# Never commit a filled-in .env and never paste a real URI into logs or tickets.
DB_URI="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Fallback style, used only when DB_URI is empty.
DB_HOST="aws-0-ap-northeast-2.pooler.supabase.com"
DB_PORT=5432
DB_NAME="postgres"
DB_USER=
DB_PASSWORD=

DB_SSL_MODE="require"

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------
# Redis QR metadata cache
# ---------------------------------------------------------------------------
# Leave blank to run without caching. The QR service will fall back to the
# database when Redis is unavailable.
REDIS_URL="redis://localhost:6379/0"

# Docker Compose uses the internal Redis service name:
# REDIS_URL="redis://redis:6379/0"

# ---------------------------------------------------------------------------
# Dynamic QR signing
# ---------------------------------------------------------------------------
# Use a strong environment-specific value and never commit the generated
# secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DYNAMIC_QR_HMAC_SECRET=

# ---------------------------------------------------------------------------
# Keycloak access-token validation
# ---------------------------------------------------------------------------
# Shared deployed Keycloak development realm. The issuer must match the `iss`
# claim inside the access token byte for byte.
KEYCLOAK_EXPECTED_ISSUER="https://keycloak-production-be79.up.railway.app/realms/Uni%20Attend"

# Optional extra accepted issuers, each paired with its OWN jwks_url
# ("issuer|jwks_url", comma-separated for more than one) - a second issuer
# needs its own key source because a different Keycloak deployment signs
# with a different key, e.g. the local Docker Keycloak the web app still uses:
# KEYCLOAK_ADDITIONAL_ISSUERS="http://localhost:8080/realms/uniattend|http://localhost:8080/realms/uniattend/protocol/openid-connect/certs"
KEYCLOAK_ADDITIONAL_ISSUERS=

# KEYCLOAK_JWKS_URL is fetched by the backend itself. For the shared deployed
# realm, use the same issuer plus /protocol/openid-connect/certs.
KEYCLOAK_JWKS_URL="https://keycloak-production-be79.up.railway.app/realms/Uni%20Attend/protocol/openid-connect/certs"

# Docker Compose can fetch JWKS through the internal Keycloak service name:
# KEYCLOAK_JWKS_URL="http://keycloak:8080/realms/uniattend/protocol/openid-connect/certs"

KEYCLOAK_AUDIENCE="uniattend-api"
KEYCLOAK_AUTHORIZED_CLIENTS="uniattend-mobile,uniattend-web"
KEYCLOAK_LEEWAY_SECONDS=5
KEYCLOAK_SIGNING_ALGORITHM="RS256"
KEYCLOAK_JWKS_CACHE_SECONDS=300

# Backend-to-service URL for the separate face-verification API.
# Docker Compose uses the internal service name:
# FACE_VERIFICATION_SERVICE_URL="http://face-verification:8001"
FACE_VERIFICATION_SERVICE_URL="http://localhost:8001"

# ---------------------------------------------------------------------------
# Geofence validation safeguards
# ---------------------------------------------------------------------------
# Radius and accuracy policy are stored per attendance session in PostgreSQL.
GEOFENCE_MAX_READING_AGE_SECONDS=30
GEOFENCE_MAX_FUTURE_SKEW_SECONDS=5
GEOFENCE_MAX_ATTEMPTS=3
