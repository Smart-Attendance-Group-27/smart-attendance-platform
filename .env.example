# Copy this file to .env at the repository root before running docker compose.
# Keep real passwords, tokens and Supabase credentials only in your local .env.

COMPOSE_PROJECT_NAME=uniattend

# Host ports exposed by Docker Compose.
WEB_PORT=3000
CORE_API_PORT=8000
FACE_VERIFICATION_PORT=8001
REDIS_PORT=6379
KEYCLOAK_HTTP_PORT=8080
KEYCLOAK_HEALTH_PORT=9000
KEYCLOAK_DB_PORT=5433

# External Supabase PostgreSQL database used by the main application services.
# DB_URI takes precedence over the individual DB fields.
CORE_DB_URI=postgresql://USER:PASSWORD@HOST:5432/postgres
CORE_DB_HOST=
CORE_DB_PORT=5432
CORE_DB_NAME=postgres
CORE_DB_USER=
CORE_DB_PASSWORD=
CORE_DB_SSL_MODE=require

# Face verification currently uses the same external database by default.
# Set FACE_DB_URI only if that service should connect to a different database.
FACE_DB_URI=
FACE_DB_HOST=
FACE_DB_PORT=5432
FACE_DB_NAME=postgres
FACE_DB_USER=
FACE_DB_PASSWORD=
FACE_DB_SSL_MODE=require
FACE_EMBEDDING_ENCRYPTION_KEY=replace-with-32-byte-urlsafe-base64-key
FACE_MAX_ATTEMPTS=3

# Redis is internal to Compose for the backend, but exposed on localhost for
# local inspection tools.
CORE_REDIS_URL=redis://redis:6379/0

# Keycloak local development settings.
KEYCLOAK_REALM=uniattend
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-local-admin-password
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=replace-with-local-keycloak-db-password

# Shared deployed Keycloak development realm used by the mobile app and Core API.
# For the local Docker Keycloak fallback, use:
#   KEYCLOAK_EXPECTED_ISSUER=http://localhost:8080/realms/uniattend
#   CORE_KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/uniattend/protocol/openid-connect/certs
KEYCLOAK_EXPECTED_ISSUER=https://keycloak-production-be79.up.railway.app/realms/Uni%20Attend
CORE_KEYCLOAK_JWKS_URL=https://keycloak-production-be79.up.railway.app/realms/Uni%20Attend/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=uniattend-api
KEYCLOAK_AUTHORIZED_CLIENTS=uniattend-mobile,uniattend-web
KEYCLOAK_LEEWAY_SECONDS=5

# Required for dynamic QR creation and verification.
DYNAMIC_QR_HMAC_SECRET=replace-with-long-random-local-secret

# Internal service URLs used by containers.
WEB_CORE_BACKEND_URL=http://core-api:8000
FACE_VERIFICATION_SERVICE_URL=http://face-verification:8001
FACE_VERIFICATION_TIMEOUT_SECONDS=30
FACE_CORE_API_URL=http://core-api:8000
FACE_CORE_API_TIMEOUT_SECONDS=5

# Web dashboard authentication. WEB_KEYCLOAK_ISSUER is browser-facing, so use
# localhost for laptop browser testing, not the Docker service name.
WEB_BASE_URL=http://localhost:3000
WEB_SESSION_SECRET=replace-with-local-random-session-secret
WEB_KEYCLOAK_ISSUER=http://localhost:8080/realms/uniattend
WEB_KEYCLOAK_INTERNAL_ISSUER=http://keycloak:8080/realms/uniattend
WEB_KEYCLOAK_CLIENT_ID=uniattend-web
WEB_KEYCLOAK_CLIENT_SECRET=uniattend-web-dev-secret-change-me
