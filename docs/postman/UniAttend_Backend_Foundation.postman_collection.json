{
  "info": {
    "_postman_id": "4b7d0c92-8e15-4a3f-b6d0-5c2e91a7f803",
    "name": "UniAttend Backend Foundation",
    "description": "Health, authentication and student profile checks for the UniAttend core backend.\n\nAuthentication uses OAuth 2.0 Authorization Code with PKCE against local Keycloak. Direct password grants are deliberately not used.\n\nAdd this exact callback URL to the uniattend-postman client in Keycloak:\n\n    https://oauth.pstmn.io/v1/callback\n\nNo token, password or client secret is stored in this file. Fill the token variables in the UniAttend Local environment at run time and clear them afterwards.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "tokenName", "value": "UniAttend student token", "type": "string" },
      { "key": "grant_type", "value": "authorization_code_with_pkce", "type": "string" },
      { "key": "authUrl", "value": "{{keycloakBaseUrl}}/realms/{{realm}}/protocol/openid-connect/auth", "type": "string" },
      { "key": "accessTokenUrl", "value": "{{keycloakBaseUrl}}/realms/{{realm}}/protocol/openid-connect/token", "type": "string" },
      { "key": "clientId", "value": "{{postmanClientId}}", "type": "string" },
      { "key": "redirect_uri", "value": "{{postmanCallbackUrl}}", "type": "string" },
      { "key": "scope", "value": "openid profile email", "type": "string" },
      { "key": "challengeAlgorithm", "value": "S256", "type": "string" },
      { "key": "client_authentication", "value": "none", "type": "string" },
      { "key": "addTokenTo", "value": "header", "type": "string" }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Applies to every request in this collection.",
          "const maxResponseTimeMs = Number(pm.environment.get('maxResponseTimeMs') || 2000);",
          "",
          "pm.test('Responds within the local time budget', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(maxResponseTimeMs);",
          "});",
          "",
          "pm.test('Responds with JSON', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "pm.test('Never leaks credentials or connection details', function () {",
          "    const body = pm.response.text().toLowerCase();",
          "    pm.expect(body).to.not.include('password');",
          "    pm.expect(body).to.not.include('postgresql://');",
          "    pm.expect(body).to.not.include('pooler.supabase.com');",
          "    pm.expect(body).to.not.include('token_secret');",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Backend health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/health",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["health"]
        },
        "description": "Confirms the FastAPI process is running. Needs no token."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Reports ok', function () {",
              "    pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Database health",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/health/db",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["health", "db"]
        },
        "description": "Confirms the backend can reach Supabase over SSL. A failure here means the local .env is wrong; the response must not reveal why in credential terms."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Database reports connected', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.status).to.eql('ok');",
              "    pm.expect(body.database).to.eql('connected');",
              "});",
              "",
              "pm.test('Response has no host or user detail', function () {",
              "    const body = pm.response.text();",
              "    pm.expect(body).to.not.include('@');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Current user without a token",
      "request": {
        "auth": { "type": "noauth" },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/me",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "me"]
        },
        "description": "An unauthenticated call must be refused with 401 and a bearer challenge."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Challenges for a bearer token', function () {",
              "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
              "});",
              "",
              "pm.test('Explains that a token is required', function () {",
              "    pm.expect(pm.response.json().detail).to.include('bearer access token');",
              "});",
              "",
              "pm.test('Returns no user data', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('id');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Current user with a valid token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/me",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "me"]
        },
        "description": "Uses the collection PKCE token. Sign in as the linked active student. Returns the internal application user, never Keycloak internals."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns the internal user id, email and roles', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('id');",
              "    pm.expect(body).to.have.property('email');",
              "    pm.expect(body.roles).to.be.an('array');",
              "});",
              "",
              "pm.test('Internal id is a UUID, not a Keycloak subject', function () {",
              "    pm.expect(pm.response.json().id).to.match(",
              "        /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i,",
              "    );",
              "});",
              "",
              "pm.test('Hides sensitive account fields', function () {",
              "    const body = pm.response.json();",
              "    ['password_hash', 'passwordHash', 'keycloak_user_id', 'keycloakUserId',",
              "     'account_status', 'failed_login_attempts', 'locked_until']",
              "        .forEach(function (field) {",
              "            pm.expect(body).to.not.have.property(field);",
              "        });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Student profile with a valid student token",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/students/me/profile",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "students", "me", "profile"]
        },
        "description": "The happy path. Uses the collection PKCE token for the linked active student."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Returns the mobile profile shape', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('id');",
              "    pm.expect(body).to.have.property('registrationNumber');",
              "    pm.expect(body).to.have.property('fullName');",
              "    pm.expect(body).to.have.property('universityEmail');",
              "});",
              "",
              "pm.test('Fields are non-empty strings', function () {",
              "    const body = pm.response.json();",
              "    ['registrationNumber', 'fullName', 'universityEmail'].forEach(function (field) {",
              "        pm.expect(body[field]).to.be.a('string').and.to.have.length.above(0);",
              "    });",
              "});",
              "",
              "pm.test('Hides internal profile fields', function () {",
              "    const body = pm.response.json();",
              "    ['user_id', 'userId', 'profile_status', 'profileStatus', 'department_id',",
              "     'password_hash', 'keycloak_user_id']",
              "        .forEach(function (field) {",
              "            pm.expect(body).to.not.have.property(field);",
              "        });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Student profile with a lecturer token",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{lecturerAccessToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/students/me/profile",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "students", "me", "profile"]
        },
        "description": "Set lecturerAccessToken by signing in through PKCE as a linked lecturer and copying the access token into the environment. Expect a refusal on role, not a profile."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('lecturerAccessToken is set', function () {",
              "    pm.expect(pm.environment.get('lecturerAccessToken')).to.be.a('string').and.to.have.length.above(0);",
              "});",
              "",
              "pm.test('Status is 403', function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test('Explains that the student role is required', function () {",
              "    pm.expect(pm.response.json().detail).to.include('student');",
              "});",
              "",
              "pm.test('Returns no profile data', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('registrationNumber');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "7. Student profile with an invalid token",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{invalidAccessToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/students/me/profile",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "students", "me", "profile"]
        },
        "description": "A token that is not a valid Keycloak JWT. Also try an expired token and a token from another issuer: all must be 401."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 401', function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test('Challenges for a bearer token', function () {",
              "    pm.expect(pm.response.headers.get('WWW-Authenticate')).to.include('Bearer');",
              "});",
              "",
              "pm.test('Returns no profile data', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('registrationNumber');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "8. Student profile with an unlinked Keycloak user",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [{ "key": "token", "value": "{{unlinkedAccessToken}}", "type": "string" }]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/students/me/profile",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "students", "me", "profile"]
        },
        "description": "A real Keycloak account whose sub is not in identity.users.keycloak_user_id. The token is valid, but no application user exists, so the answer is 404 and not 401."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('unlinkedAccessToken is set', function () {",
              "    pm.expect(pm.environment.get('unlinkedAccessToken')).to.be.a('string').and.to.have.length.above(0);",
              "});",
              "",
              "pm.test('Status is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Explains that no application user is linked', function () {",
              "    pm.expect(pm.response.json().detail.toLowerCase()).to.include('linked');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Linked student without a profile",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            { "key": "token", "value": "{{studentWithoutProfileAccessToken}}", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{coreApiBaseUrl}}/api/v1/students/me/profile",
          "host": ["{{coreApiBaseUrl}}"],
          "path": ["api", "v1", "students", "me", "profile"]
        },
        "description": "A linked active user with the student role but no row in academic.student_profiles. The identity resolves, the profile does not."
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('studentWithoutProfileAccessToken is set', function () {",
              "    pm.expect(pm.environment.get('studentWithoutProfileAccessToken')).to.be.a('string').and.to.have.length.above(0);",
              "});",
              "",
              "pm.test('Status is 404', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test('Explains that the student profile was not found', function () {",
              "    pm.expect(pm.response.json().detail.toLowerCase()).to.include('profile');",
              "});",
              "",
              "pm.test('Returns no profile data', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('registrationNumber');",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "coreApiBaseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ]
}
