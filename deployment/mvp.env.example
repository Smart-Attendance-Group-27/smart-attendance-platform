# Copy to deployment/mvp.env and replace every replace-* value.
# Never commit deployment/mvp.env.

COMPOSE_PROJECT_NAME=uniattend-mvp
IMAGE_TAG=replace-with-release-sha
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
CORE_API_PORT=8000
FACE_VERIFICATION_PORT=8001

# External PostgreSQL. Use the pooler/connection values approved for the target.
CORE_DB_URI=postgresql://replace-user:replace-password@replace-db-host:5432/postgres
FACE_DB_URI=postgresql://replace-user:replace-password@replace-db-host:5432/postgres
DB_SSL_MODE=require
CORE_DB_POOL_MIN_SIZE=1
CORE_DB_POOL_MAX_SIZE=5
FACE_DB_POOL_MIN_SIZE=1
FACE_DB_POOL_MAX_SIZE=5
DB_COMMAND_TIMEOUT_SECONDS=10

# Public URLs. Put a TLS reverse proxy or managed HTTPS ingress in front of the
# loopback-bound container ports.
WEB_BASE_URL=https://replace-web.example.edu
CORE_PUBLIC_BASE_URL=https://replace-api.example.edu
FACE_PUBLIC_BASE_URL=https://replace-face.example.edu

# Shared Keycloak realm and API token validation.
KEYCLOAK_EXPECTED_ISSUER=https://replace-keycloak.example.edu/realms/uniattend
CORE_KEYCLOAK_JWKS_URL=https://replace-keycloak.example.edu/realms/uniattend/protocol/openid-connect/certs
KEYCLOAK_ADDITIONAL_ISSUERS=
KEYCLOAK_AUDIENCE=uniattend-api
KEYCLOAK_AUTHORIZED_CLIENTS=uniattend-mobile,uniattend-web
KEYCLOAK_LEEWAY_SECONDS=5

# Keycloak service account used by administrator account provisioning.
KEYCLOAK_ADMIN_BASE_URL=https://replace-keycloak.example.edu
KEYCLOAK_ADMIN_REALM=uniattend
KEYCLOAK_ADMIN_CLIENT_ID=uniattend-provisioner
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-keycloak-admin-client-secret

# Web BFF/OIDC client. WEB_BASE_URL/api/auth/callback must be an allowed URI.
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters
WEB_KEYCLOAK_ISSUER=https://replace-keycloak.example.edu/realms/uniattend
WEB_KEYCLOAK_INTERNAL_ISSUER=
WEB_KEYCLOAK_CLIENT_ID=uniattend-web
WEB_KEYCLOAK_CLIENT_SECRET=replace-with-web-keycloak-client-secret

# Server-only application secrets.
DYNAMIC_QR_HMAC_SECRET=replace-with-at-least-32-random-characters
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACE_EMBEDDING_ENCRYPTION_KEY=replace-with-fernet-key

# Face runtime. Integrated attendance requires valid mobile liveness evidence.
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_VERSION=1
FACE_EXECUTION_PROVIDER=CPUExecutionProvider
FACE_CONTEXT_ID=-1
FACE_DETECTION_SIZE=640
FACE_MINIMUM_DETECTION_CONFIDENCE=0.60
FACE_MAX_CONCURRENT_INFERENCES=1
FACE_INFERENCE_QUEUE_TIMEOUT_SECONDS=20
FACE_MAX_ATTEMPTS=3
LIVENESS_MAX_AGE_SECONDS=120
FACE_VERIFICATION_TIMEOUT_SECONDS=30
FACE_CORE_API_TIMEOUT_SECONDS=5

# Keep background delivery off for the first smoke deployment. Enable only
# after the notification migrations and Android credentials are verified.
PUSH_WORKER_ENABLED=false
REMINDER_SCHEDULER_ENABLED=false
EXPO_ACCESS_TOKEN=
EXPO_PUSH_TIMEOUT_SECONDS=10
PUSH_WORKER_POLL_INTERVAL_SECONDS=2
PUSH_WORKER_BATCH_SIZE=100
PUSH_WORKER_RECEIPT_BATCH_SIZE=1000
PUSH_WORKER_RECEIPT_DELAY_SECONDS=15
PUSH_WORKER_LEASE_TIMEOUT_SECONDS=60
PUSH_WORKER_MAX_ATTEMPTS=5
PUSH_WORKER_RETRY_BASE_SECONDS=5
PUSH_WORKER_RETRY_MAX_SECONDS=300
PUSH_WORKER_SHUTDOWN_TIMEOUT_SECONDS=15
REMINDER_SCHEDULER_INTERVAL_SECONDS=60
REMINDER_LEAD_MINUTES=15

# Set these in the EAS build environment as public, non-secret URLs/settings.
EXPO_PUBLIC_CORE_API_URL=https://replace-api.example.edu
EXPO_PUBLIC_FACE_VERIFICATION_API_URL=https://replace-face.example.edu
EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=https://replace-keycloak.example.edu/realms/uniattend
EXPO_PUBLIC_KEYCLOAK_REALM=uniattend
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=uniattend-mobile
