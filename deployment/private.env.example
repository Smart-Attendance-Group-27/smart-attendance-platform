# Private first release. Store the filled file at /etc/uniattend/private.env (0600).
# The temporary sslip.io names resolve to the VPS. Until ingress opens,
# application ports remain loopback-only and are checked over SSH tunnels.
DEPLOY_IMAGE_PREFIX=ghcr.io/smart-attendance-group-27/smart-attendance-platform
IMAGE_TAG=replace-with-merged-commit-sha
CORE_DB_URI=postgresql://replace-user:replace-password@replace-host:5432/postgres
FACE_DB_URI=postgresql://replace-user:replace-password@replace-host:5432/postgres
FACE_EMBEDDING_ENCRYPTION_KEY=replace-with-existing-fernet-key
PILOT_DISABLE_FACE_ATTENDANCE=false
FACE_MODEL_NAME=buffalo_l
FACE_MODEL_VERSION=1
FACE_EXECUTION_PROVIDER=CPUExecutionProvider
FACE_CONTEXT_ID=-1
FACE_DETECTION_SIZE=640
FACE_MINIMUM_DETECTION_CONFIDENCE=0.60
FACE_MAX_CONCURRENT_INFERENCES=1
FACE_INFERENCE_QUEUE_TIMEOUT_SECONDS=20
FACE_MAX_ATTEMPTS=3
LIVENESS_MAX_AGE_SECONDS=120
FACE_VERIFICATION_TIMEOUT_SECONDS=30
FACE_CORE_API_TIMEOUT_SECONDS=5
KEYCLOAK_DB_PASSWORD=replace-with-new-random-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-new-random-password
KEYCLOAK_ADMIN_CLIENT_SECRET=replace-with-new-random-secret
WEB_KEYCLOAK_CLIENT_SECRET=replace-with-new-random-secret
WEB_SESSION_SECRET=replace-with-new-random-secret
DYNAMIC_QR_HMAC_SECRET=replace-with-new-random-secret
WEB_BASE_URL=https://app.152-53-33-198.sslip.io
KEYCLOAK_PUBLIC_URL=https://auth.152-53-33-198.sslip.io
KEYCLOAK_EXPECTED_ISSUER=https://auth.152-53-33-198.sslip.io/realms/uniattend
KEYCLOAK_REALM_FILE=/etc/uniattend/realm.json
