# Recommended for a physical Android phone connected over USB. Run the adb
# reverse commands in docs/geofence-validation-demo.md before opening the app.
EXPO_PUBLIC_KEYCLOAK_HOST=localhost
EXPO_PUBLIC_CORE_API_URL=http://localhost:8000

# For Wi-Fi testing, replace localhost in both values with the laptop's LAN
# IPv4 address. Never put passwords, tokens, or private keys in EXPO_PUBLIC_*.
