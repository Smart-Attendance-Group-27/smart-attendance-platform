# First VPS pilot. These are public URLs only; no client secret belongs here.
EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=https://auth.152-53-33-198.sslip.io/realms/uniattend
EXPO_PUBLIC_KEYCLOAK_REALM=uniattend
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=uniattend-mobile
EXPO_PUBLIC_CORE_API_URL=https://api.152-53-33-198.sslip.io
EXPO_PUBLIC_FACE_VERIFICATION_API_URL=https://face.152-53-33-198.sslip.io
EXPO_PUBLIC_API_MODE=api

# Local fallback for Docker Keycloak. Used only when
# EXPO_PUBLIC_KEYCLOAK_ISSUER_URL is blank.
EXPO_PUBLIC_KEYCLOAK_HOST=localhost
# EXPO_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8080

# For local development instead of the VPS, set the Core and Face URLs to
# localhost (with adb reverse) or your laptop's LAN address, and use the
# local Keycloak realm. Never put passwords or private keys in EXPO_PUBLIC_*.
