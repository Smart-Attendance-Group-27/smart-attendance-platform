# Shared deployed Keycloak development realm. Prefer setting the full issuer
# URL so emulator, physical phone and browser-based auth all use the same realm.
EXPO_PUBLIC_KEYCLOAK_ISSUER_URL=https://keycloak-production-be79.up.railway.app/realms/Uni%20Attend
EXPO_PUBLIC_KEYCLOAK_REALM="Uni Attend"
EXPO_PUBLIC_KEYCLOAK_CLIENT_ID=uniattend-mobile

# Local fallback for Docker Keycloak. Used only when
# EXPO_PUBLIC_KEYCLOAK_ISSUER_URL is blank.
EXPO_PUBLIC_KEYCLOAK_HOST=localhost
# EXPO_PUBLIC_KEYCLOAK_BASE_URL=http://localhost:8080

# Recommended for a physical Android phone connected over USB. Run the adb
# reverse commands in docs/geofence-validation-demo.md before opening the app.
EXPO_PUBLIC_CORE_API_URL=http://localhost:8000
EXPO_PUBLIC_FACE_VERIFICATION_API_URL=http://localhost:8001

# For Wi-Fi testing, replace localhost in EXPO_PUBLIC_CORE_API_URL with the
# laptop's LAN IPv4 address. Never put passwords, tokens, or private keys in
# EXPO_PUBLIC_*.
