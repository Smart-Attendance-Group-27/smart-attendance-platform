# Server-side only: FastAPI core backend base URL, used by the /api proxy routes.
CORE_BACKEND_URL=http://127.0.0.1:8000

# Server-side only: secret used to sign the dashboard's session cookie (lib/auth/session.ts).
# Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-local-random-session-secret

# Keycloak web client (see infra/local/keycloak/realm/uniattend-realm.json — "uniattend-web").
# Same realm/host convention as apps/mobile/.env.example's EXPO_PUBLIC_KEYCLOAK_HOST.
KEYCLOAK_ISSUER=http://localhost:8080/realms/uniattend
# Optional for Docker: server-side calls use this internal URL, while browser
# redirects still use KEYCLOAK_ISSUER.
KEYCLOAK_INTERNAL_ISSUER=
KEYCLOAK_CLIENT_ID=uniattend-web
# Local-dev-only value, matches the realm file. Never commit a real production secret here —
# generate one in the Keycloak admin console and set it only in a non-committed .env.local.
KEYCLOAK_CLIENT_SECRET=uniattend-web-dev-secret-change-me

# Server-side only: this app's own externally-reachable base URL, used to build the
# Keycloak redirect_uri deterministically (must match a redirect URI on the client above).
WEB_BASE_URL=http://localhost:3000
